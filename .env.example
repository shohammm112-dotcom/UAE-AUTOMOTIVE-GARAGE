# ---------------------------------------------------------------------------
# Loaded by `dotenv/config` at the top of server.ts.
#
# PRODUCTION DEPLOYMENTS: the two variables marked REQUIRED are asserted at
# startup. If either is missing the process exits non-zero rather than booting
# in a degraded state. This is deliberate - a production instance that resolved
# to mock infrastructure accepted seeded tokens granting administrative access.
# ---------------------------------------------------------------------------

# REQUIRED in production. Must be exactly "firebase" (case-insensitive,
# surrounding whitespace tolerated). Any other value resolves to "mock", which
# a production process refuses to start with.
INFRASTRUCTURE_PROVIDER=

# REQUIRED in production. Comma-separated browser origins permitted to call the
# API, e.g. https://garage.example.ae. The localhost defaults used in
# development match nothing a deployed browser sends, including the app's own
# origin, so leaving this unset in production blocks every request.
ALLOWED_ORIGINS=

# Required whenever INFRASTRUCTURE_PROVIDER=firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
